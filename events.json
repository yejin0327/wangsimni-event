import json
import re
from datetime import datetime, timezone
from pathlib import Path

import requests
from bs4 import BeautifulSoup


BASE_URL = "https://www.velyb.kr/community/community01.php"

OUTPUT_FILE = Path("events.json")

HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) "
        "AppleWebKit/537.36 (KHTML, like Gecko) "
        "Chrome/140.0 Safari/537.36"
    ),
    "Accept-Language": "ko-KR,ko;q=0.9",
}


CATEGORIES = {
    1: "기획전",
    2: "쁘띠성형",
    3: "피부",
    4: "리프팅",
    5: "부스터",
    6: "제모",
    7: "비만",
}


def clean(text):
    text = text.replace("\xa0", " ")
    text = re.sub(r"\s+", " ", text)
    return text.strip()


def fetch_page(category_id):
    params = {
        "tb": "event_multi",
        "etc5": "왕십리점",
        "sField": str(category_id),
    }

    response = requests.get(
        BASE_URL,
        params=params,
        headers=HEADERS,
        timeout=30,
    )

    response.raise_for_status()
    response.encoding = response.apparent_encoding

    return response.text


def get_lines(html):
    soup = BeautifulSoup(html, "html.parser")

    # 자바스크립트 / CSS 제거
    for tag in soup.find_all(
        ["script", "style", "noscript"]
    ):
        tag.decompose()

    text = soup.get_text("\n")

    lines = []

    for line in text.splitlines():

        line = clean(line)

        if line:
            lines.append(line)

    return lines


def parse_discount_price(text):

    """
    예:

    48% 12,900원 ~~25,200~~원

    """

    pattern = re.search(
        r"(\d+)\s*%\s*"
        r"([\d,]+)\s*원"
        r"(?:\s*~~\s*([\d,]+)\s*~~\s*원)?",
        text,
    )

    if not pattern:
        return None

    return {
        "discount": int(pattern.group(1)),
        "price": int(
            pattern.group(2).replace(",", "")
        ),
        "normal": (
            int(
                pattern.group(3).replace(",", "")
            )
            if pattern.group(3)
            else None
        ),
    }


def parse_plain_price(text):

    match = re.search(
        r"([\d,]+)\s*원",
        text,
    )

    if not match:
        return None

    return int(
        match.group(1).replace(",", "")
    )


def is_price_line(text):

    return bool(
        re.search(
            r"[\d,]+\s*원",
            text,
        )
    )


def is_ui_text(text):

    bad_words = [
        "왕십리점",
        "지점안내",
        "온라인상담",
        "전화상담신청",
        "보기 토글",
        "패키지 보기 토글",
        "전체시술",
        "기획전",
        "쁘띠성형",
        "피부",
        "리프팅",
        "부스터",
        "제모",
        "비만",
        "로그인",
        "회원가입",
        "LOGIN",
        "JOIN",
    ]

    if text in bad_words:
        return True

    if text.startswith("※"):
        return True

    return False


def looks_like_event_item(text):

    if not text:
        return False

    if len(text) < 2:
        return False

    if len(text) > 300:
        return False

    if is_price_line(text):
        return False

    if is_ui_text(text):
        return False

    # 날짜 문구 제외
    if re.fullmatch(
        r"\d{4}-\d{2}-\d{2}까지",
        text,
    ):
        return False

    return True


def extract_events(html, category_id):

    lines = get_lines(html)

    events = []

    source_url = (
        BASE_URL
        + "?tb=event_multi"
        + "&etc5=%EC%99%95%EC%8B%AD%EB%A6%AC%EC%A0%90"
        + f"&sField={category_id}"
    )

    current_event_title = None
    current_event_date = None

    for i, line in enumerate(lines):

        # --------------------------------
        # 이벤트 날짜
        # --------------------------------

        date_match = re.fullmatch(
            r"(\d{4}-\d{2}-\d{2})까지",
            line,
        )

        if date_match:

            current_event_date = (
                date_match.group(1)
            )

            current_event_title = None

            continue


        # --------------------------------
        # 가격이 아닌 일반 텍스트
        # --------------------------------

        if not is_price_line(line):

            # 가격이 나오기 전에는
            # 현재 이벤트 제목을 업데이트
            #
            # 단, 설명문도 섞이기 때문에
            # 가격 바로 앞의 텍스트를 실제
            # 시술명으로 사용하는 것이 핵심입니다.

            continue


        # --------------------------------
        # 할인 가격
        # --------------------------------

        parsed = parse_discount_price(line)

        plain_price = None

        if parsed is None:

            plain_price = parse_plain_price(
                line
            )

        if parsed is None and plain_price is None:
            continue


        # --------------------------------
        # 가격 바로 앞의 줄 찾기
        # --------------------------------

        title = None

        previous_index = i - 1

        while previous_index >= 0:

            previous = clean(
                lines[previous_index]
            )

            if not previous:
                previous_index -= 1
                continue

            # 가격 줄이면 건너뜀
            if is_price_line(previous):
                previous_index -= 1
                continue

            if is_ui_text(previous):
                previous_index -= 1
                continue

            # 날짜면 더 이상 위로 올라가지 않음
            if re.fullmatch(
                r"\d{4}-\d{2}-\d{2}까지",
                previous,
            ):
                break

            if looks_like_event_item(
                previous
            ):

                title = previous
                break

            previous_index -= 1


        if not title:
            continue


        # --------------------------------
        # 옵션 여부
        # --------------------------------

        is_option = (
            title.startswith("옵션")
            or title.startswith("추가")
            or "옵션" in title[:15]
        )


        # --------------------------------
        # 데이터 생성
        # --------------------------------

        event = {
            "category": CATEGORIES[
                category_id
            ],

            "name": title,

            "price": (
                parsed["price"]
                if parsed
                else plain_price
            ),

            "normal": (
                parsed["normal"]
                if parsed
                else None
            ),

            "discount": (
                parsed["discount"]
                if parsed
                else None
            ),

            "option": is_option,

            "event_date": (
                current_event_date
            ),

            "source": source_url,
        }

        events.append(event)

    return events


def remove_duplicates(events):

    result = []

    seen = set()

    for event in events:

        key = (
            event["category"],
            event["name"],
            event["price"],
            event["normal"],
        )

        if key in seen:
            continue

        seen.add(key)

        result.append(event)

    return result


def main():

    print("")
    print("================================")
    print(" 블리비 왕십리점 자동 이벤트 수집")
    print("================================")
    print("")

    all_events = []


    # --------------------------------
    # 왕십리점 전체 카테고리 수집
    # --------------------------------

    for category_id, category_name in CATEGORIES.items():

        print(
            f"[{category_id}/7] "
            f"{category_name} 수집 중..."
        )

        try:

            html = fetch_page(
                category_id
            )

            events = extract_events(
                html,
                category_id
            )

            print(
                f"    → {len(events)}개 발견"
            )

            all_events.extend(events)

        except Exception as error:

            print(
                f"    → 오류 발생: {error}"
            )


    # --------------------------------
    # 중복 제거
    # --------------------------------

    all_events = remove_duplicates(
        all_events
    )


    if not all_events:

        raise RuntimeError(
            "이벤트 데이터를 찾지 못했습니다."
        )


    # --------------------------------
    # 수집 시간
    # --------------------------------

    collected_at = (
        datetime.now(
            timezone.utc
        )
        .astimezone()
        .isoformat()
    )


    for event in all_events:

        event["collected_at"] = (
            collected_at
        )


    # --------------------------------
    # 정렬
    # --------------------------------

    all_events.sort(
        key=lambda x: (
            x["category"],
            x["name"],
            x["price"] or 0,
        )
    )


    # --------------------------------
    # events.json 저장
    # --------------------------------

    OUTPUT_FILE.write_text(
        json.dumps(
            all_events,
            ensure_ascii=False,
            indent=2,
        ),
        encoding="utf-8",
    )


    # --------------------------------
    # 결과 출력
    # --------------------------------

    print("")
    print("================================")
    print(
        f"총 {len(all_events)}개 수집 완료"
    )
    print("================================")
    print("")


    # --------------------------------
    # 검색 테스트
    # --------------------------------

    keywords = [
        "슈링크",
        "울쎄라",
        "인모드",
        "보톡스",
        "필러",
        "제모",
        "리프팅",
    ]


    for keyword in keywords:

        matches = [
            event
            for event in all_events
            if keyword.lower()
            in event["name"].lower()
        ]

        print(
            f"검색 테스트: "
            f"{keyword} → "
            f"{len(matches)}개"
        )


        # 슈링크 실제 데이터 출력
        if keyword == "슈링크":

            for event in matches[:10]:

                print(
                    "   ",
                    event["name"],
                    "→",
                    f'{event["price"]:,}원'
                    if event["price"]
                    else "가격없음",
                )


    print("")


if __name__ == "__main__":
    main()
